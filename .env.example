# Copy to .env and fill in. Never commit .env.

# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave both empty to run in MOCK MODE (no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: route every relief-partner payout to one Sandbox personal account you control,
# so payout items reach SUCCESS instead of UNCLAIMED.
PAYPAL_PAYOUT_RECIPIENT_EMAIL=
# Optional: public HTTPS base URL for PayPal webhooks (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_BASE_URL=
# Optional: use an existing PayPal webhook ID instead of registering one at startup
PAYPAL_WEBHOOK_ID=

# Claude (console.anthropic.com). Leave empty for AI OFFLINE template responses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

PORT=8787
